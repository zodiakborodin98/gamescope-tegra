+void m9w_log(const char *fmt,...){
+ char buf[1024];va_list ap;va_start(ap,fmt);int n=vsnprintf(buf,sizeof(buf),fmt,ap);va_end(ap);
+ if(n<0)return;
+ if(n>=(int)sizeof(buf))n=sizeof(buf)-1;

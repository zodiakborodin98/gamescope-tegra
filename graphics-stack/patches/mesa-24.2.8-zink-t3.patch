+static void
+t3_read_starttime(char *out, size_t cap)
+{
+    char buf[1024];
+    out[0] = '\0';
+    int fd = open("/proc/self/stat", O_RDONLY);
+    if (fd < 0)
+        return;
+    ssize_t n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    if (n <= 0)
+        return;
+    buf[n] = '\0';
+    char *p = strrchr(buf, ')');
+    if (!p)
+        return;
+    p++;
+    /* the 20th token after comm is field 22 = starttime */
+    for (int i = 0; i < 20 && *p; i++) {
+        while (*p == ' ')
+            p++;
+        char *tok = p;
+        while (*p && *p != ' ')
+            p++;
+        if (i == 19) {
+            size_t m = (size_t)(p - tok);
+            if (m >= cap)
+                m = cap - 1;
+            memcpy(out, tok, m);
+            out[m] = '\0';
+            return;
+        }
+    }
+}
